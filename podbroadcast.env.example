# PodBroadcast Environment Configuration
# Copy this file to /etc/podbroadcast/podbroadcast.env (for systemd service)
# or source it before running the script manually

# Required: API key for authentication
# Generate a secure key with: openssl rand -hex 32
PODBROADCAST_KEY=your-secret-key-here

# Optional: Host to bind to (default: 0.0.0.0)
PODBROADCAST_HOST=0.0.0.0

# Optional: Port to listen on (default: 8080)
PODBROADCAST_PORT=8080
